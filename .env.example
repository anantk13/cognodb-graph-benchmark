# Copy this file to `.env` and fill in the values.
# `.env` is gitignored. Never commit real credentials.
#
#   cp .env.example .env
#
# Every value below is read at runtime by src/gbench/config.py.
# No connection URI or password appears anywhere else in this repository.

# ─── CognoDB Cloud (free c0 instance, region us-central1) ──────────────
# From the CognoDB console after the instance provisions.
# The password is displayed exactly once at creation time.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# ─── Neo4j AuraDB Free (region us-central1) ───────────────────────────
# From the credentials file Aura downloads when the instance is created.
NEO4J_AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# ─── Self-hosted targets ──────────────────────────────────────────────
# Started by the harness via Docker; these defaults work as-is.
NEO4J_LOCAL_URI=bolt://localhost:7687
NEO4J_LOCAL_USER=neo4j
NEO4J_LOCAL_PASSWORD=benchmarkpassword

MEMGRAPH_LOCAL_URI=bolt://localhost:7688
MEMGRAPH_LOCAL_USER=
MEMGRAPH_LOCAL_PASSWORD=

FALKORDB_LOCAL_HOST=localhost
FALKORDB_LOCAL_PORT=6379

# Kuzu is embedded — no connection details, just a path.
KUZU_LOCAL_PATH=data/build/kuzu
